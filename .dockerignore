venv/
node_modules/
frontend/
__pycache__/
*.pyc
.git/
pfp/
backend/scripts/backup_*.csv

# 비밀값은 어느 깊이에 있든 이미지에 넣지 않는다.
#
# 예전에는 `.env` 한 줄이었는데, 이 패턴은 빌드 컨텍스트 최상위의 .env 만
# 걸러낸다. 실제 키가 들어 있는 것은 backend/.env 이고 Dockerfile 이
# `COPY backend/ ./backend/` 를 하므로, DB 비밀번호·API 키가 전부 이미지에
# 박힌 채 레지스트리에 올라가고 있었다.
**/.env
**/.env.*
!**/.env.example

# secrets/firebase-admin.json — setup.sh 가 Secret Manager 에서 받아 만든다.
# 지금은 없지만(사용자가 지움) 새 머신에서 setup.sh 를 돌리면 생기고, 그러면
# 빌드 컨텍스트에 들어간다. .gitignore 에만 있어서 git 에는 안 올라가지만
# 도커 컨텍스트는 작업 디렉터리를 통째로 읽는다 — §8 의 `.env` 사고와 같은
# 형태다(그때도 .gitignore 는 막고 있었다).
secrets/
**/*.pem
**/*.key
**/serviceAccount*.json

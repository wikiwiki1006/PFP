# ─── 데이터베이스 ─────────────────────────────────────────────────────────────
# Neon·Cloud SQL 등 관리형이면 DATABASE_URL 하나로 충분하다.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# ─── Firebase 인증 ────────────────────────────────────────────────────────────
# 서비스 계정 키 경로 (로컬). Cloud Run 에서는 FIREBASE_CREDENTIALS_JSON 에
# 키 JSON 전문을 Secret Manager 로 주입한다.
FIREBASE_CREDENTIALS=secrets/firebase-admin.json
FIREBASE_PROJECT_ID=personalfinancialplatform

# 인증을 우회하는 개발용 스위치. 켜면 X-User-Id 헤더를 그대로 믿는다.
# 운영에서 절대 켜지 말 것 — 누구나 남의 계정으로 접근할 수 있다.
ALLOW_INSECURE_DEV_AUTH=false

# ─── SNS 로그인 (선택) ────────────────────────────────────────────────────────
# 네이버: https://developers.naver.com/apps → 애플리케이션 등록
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 카카오: https://developers.kakao.com → 내 애플리케이션
#
#   KAKAO_REST_API_KEY  ← "앱 키" 탭의 **REST API 키**
#                          소문자+숫자 32자 (예: 2d0f43a1b2c3...)
#                          ⚠ 흔한 실수: 아래 두 값을 여기에 넣으면 KOE101 로 거부된다
#                            · Client Secret  (대소문자 섞인 32자) → KAKAO_CLIENT_SECRET 로
#                            · JavaScript 키                       → KAKAO_JS_KEY 로
#
#   KAKAO_CLIENT_SECRET ← "보안" 탭에서 Client Secret 을 '사용함'으로 켠 경우에만 필요
#   KAKAO_JS_KEY        ← 비워 두면 REST OAuth(팝업) 방식으로 동작한다. 없어도 된다.
#
# 콘솔에서 아래 설정도 함께 해야 한다:
#   · 앱 설정 → 플랫폼 → Web → 사이트 도메인: http://localhost:3000
#   · 제품 설정 → 카카오 로그인 → 활성화 ON
#   · 제품 설정 → 카카오 로그인 → Redirect URI: http://localhost:3000/auth/kakao/callback
#   · 제품 설정 → 카카오 로그인 → 동의항목 → 닉네임(profile_nickname) 사용함  ※ 선택
#
# 이메일(account_email)은 개인 개발자 앱에서 "권한 없음"이라 요청할 수 없다.
# 요청하면 로그인 자체가 막히므로 KAKAO_SCOPE 는 비워 두는 것이 기본이다.
# 이메일이 없어도 카카오 고유 ID로 계정을 구분하므로 로그인에 지장은 없다.
# 비즈 앱으로 전환해 권한을 받은 뒤에만 KAKAO_SCOPE=account_email 로 켜면 된다.
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_JS_KEY=
# KAKAO_SCOPE=

# ─── AI / 외부 API ───────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
